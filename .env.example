# =====================================================================
# OSINTCrawler configuration
# Copy to `.env` and fill in the keys you have. Every key is OPTIONAL:
# sources without a key are skipped (or run in keyless/limited mode).
# NEVER commit `.env` - it is gitignored.
# =====================================================================

# ---------------- Core threat intel ----------------
# https://www.virustotal.com/gui/my-apikey  (free: 4 req/min, 500/day)
VT_API_KEY=
# https://www.abuseipdb.com/account/api  (free: 1,000 checks/day)
ABUSEIPDB_API_KEY=
# https://otx.alienvault.com/settings  (free; works keyless with lower limits)
OTX_API_KEY=
# https://viz.greynoise.io/account/api-key  (community; works keyless with low limits)
GREYNOISE_API_KEY=
# https://auth.abuse.ch/  (free; required for URLhaus, MalwareBazaar, ThreatFox)
ABUSECH_AUTH_KEY=

# ---------------- Infrastructure / passive DNS ----------------
# https://account.shodan.io/  (full host API needs a paid membership; InternetDB is used keyless regardless)
SHODAN_API_KEY=
# https://securitytrails.com/app/account/credentials  (small free monthly quota)
SECURITYTRAILS_API_KEY=
# https://urlscan.io/user/profile/  (search works keyless with lower limits)
URLSCAN_API_KEY=
# https://ipinfo.io/account/token  (works keyless with low limits)
IPINFO_TOKEN=
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com  (free, non-commercial)
GOOGLE_SAFEBROWSING_API_KEY=

# ---------------- Email / identity ----------------
# https://haveibeenpwned.com/API/Key  (paid subscription)
HIBP_API_KEY=
# https://hunter.io/api-keys  (free: ~25 searches/month)
HUNTER_API_KEY=
# https://emailrep.io/key  (free on request; limited keyless use)
EMAILREP_API_KEY=

# ---------------- Phone / address ----------------
# https://numverify.com/product  (free: ~100/month). Offline phone parsing needs no key.
NUMVERIFY_API_KEY=
# Default region for phone numbers written without +country code (ISO-3166 alpha-2, e.g. KE, US, GB)
DEFAULT_PHONE_REGION=

# ---------------- Vulnerabilities ----------------
# https://nvd.nist.gov/developers/request-an-api-key  (optional; raises rate limit)
NVD_API_KEY=

# ---------------- Crypto ----------------
# https://etherscan.io/myapikey  (free)
ETHERSCAN_API_KEY=
# https://www.chainabuse.com/  -> account -> API  (free on request)
CHAINABUSE_API_KEY=

# ---------------- Optional AI analyst summary ----------------
# https://console.anthropic.com/  (paid per use). Only used with --ai-summary.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---------------- Web UI (Vercel / uvicorn) ----------------
# Long random string required to use the web UI. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=
# Requests per minute per client IP (web only)
RATE_LIMIT_PER_MINUTE=20

# ---------------- Tuning ----------------
# Per-source timeout in seconds, and max concurrent HTTP requests
HTTP_TIMEOUT=15
MAX_CONCURRENCY=10
