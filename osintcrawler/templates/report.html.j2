<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<title>OSINTCrawler Report</title>
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>{% include "_theme_init.js.j2" %}</script>
<style{% if nonce %} nonce="{{ nonce }}"{% endif %}>
{% include "_base.css.j2" %}
/* ---- Report ---- */
.hero { position: relative; overflow: hidden; margin-top: 26px; padding: 28px; border-radius: 22px; color: #fff;
  background: var(--grad); box-shadow: 0 24px 50px -24px rgba(168, 85, 247, .75); }
.hero::after { content: ""; position: absolute; inset: auto -60px -90px auto; width: 260px; height: 260px; border-radius: 50%;
  background: rgba(255, 255, 255, .14); pointer-events: none; }
.hero h1 { margin: 0 0 6px; font-size: clamp(22px, 3.6vw, 30px); font-weight: 800; }
.hero .meta { color: rgba(255, 255, 255, .85); font-size: 14px; }
.hero .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
.hero .btn { background: rgba(255, 255, 255, .16); color: #fff; border-color: rgba(255, 255, 255, .3); }
.hero .btn:hover { background: rgba(255, 255, 255, .26); }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-top: 18px; }
.stat { position: relative; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
  padding: 16px 18px; box-shadow: var(--shadow); }
.stat::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--c, var(--unk)); }
.stat-num { font-size: 30px; font-weight: 800; line-height: 1.1; color: var(--c, var(--text)); }
.stat-label { color: var(--muted); font-size: 13px; font-weight: 600; margin-top: 4px; }

.section-title { font-size: 18px; font-weight: 800; margin: 0 0 12px; }
.table-wrap { overflow-x: auto; margin: 0 -6px; padding: 0 6px; }
table { width: 100%; border-collapse: separate; border-spacing: 0; }
th, td { text-align: left; vertical-align: top; padding: 12px 10px; border-bottom: 1px solid var(--border); }
th { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }
tbody tr { transition: background-color .15s; }
tbody tr:hover { background: var(--chip); }
tbody tr:last-child td { border-bottom: 0; }
.ind-value { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; word-break: break-all; font-size: 13.5px; }
.risk { display: flex; align-items: center; gap: 10px; min-width: 110px; }
.risk-num { font-weight: 800; font-variant-numeric: tabular-nums; min-width: 26px; }
.risk .meter { flex: 1; }
.findings div { margin-bottom: 3px; }

.ind-card { scroll-margin-top: 90px; }
.ind-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.ind-head h2 { margin: 0; font-size: 19px; }
.ind-head .sub { color: var(--muted); font-size: 13px; }
.ind-head .score { margin-left: auto; min-width: 180px; }
.summary-list { margin: 14px 0 6px; padding: 0; list-style: none; display: grid; gap: 8px; }
.summary-list li { padding: 10px 12px; border-radius: 12px; background: var(--code); border: 1px solid var(--border); font-size: 14px; }
.status { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 12px; text-transform: capitalize; }
.status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
.s-ok { color: var(--low); } .s-not_found { color: var(--info); } .s-error { color: var(--mal); } .s-skipped { color: var(--muted); }
.src-name { font-weight: 700; }
.src-time { color: var(--muted); font-size: 12px; }
details { margin-top: 8px; }
details summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 13px; }
pre { background: var(--code); border: 1px solid var(--border); border-radius: 12px; padding: 12px; overflow: auto;
  max-height: 420px; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
.ai { border-left: 4px solid transparent; border-image: var(--grad) 1; }
.ai p { white-space: pre-wrap; margin: 8px 0 0; }
.warn { padding: 10px 12px; border-radius: 12px; background: color-mix(in srgb, var(--sus) 14%, transparent); margin-top: 6px;
  color: var(--text); font-size: 14px; }
footer { margin-top: 36px; text-align: center; font-size: 12px; color: var(--muted); }

@media (max-width: 640px) {
  .wrap { padding: 0 14px 56px; }
  th:nth-child(2), td:nth-child(2) { display: none; }
  .ind-head .score { margin-left: 0; width: 100%; }
  .hero { padding: 22px; }
}
@media print {
  body { background: #fff; color: #000; }
  .noprint, .topbar { display: none !important; }
  .card, .stat { box-shadow: none; }
  details { display: block; }
}
</style>
</head>
<body>
<header class="topbar noprint">
  <div class="topbar-inner">
    <a class="brand" href="./">
      <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z"/><circle cx="12" cy="11" r="2.4"/></svg></span>
      <span>OSINT<span class="gradient-text">Crawler</span></span>
    </a>
    <div class="topbar-actions">
      {% if web %}<a class="btn" href="./">New lookup</a>{% endif %}
      <button class="btn" type="button" id="dl-json">Download JSON</button>
      <button class="btn btn-icon" type="button" data-theme-toggle aria-label="Toggle dark and light mode" title="Toggle theme">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

{% set total = report.indicators | length %}
{% set n_mal = report.indicators | selectattr("verdict.value", "equalto", "malicious") | list | length %}
{% set n_sus = report.indicators | selectattr("verdict.value", "equalto", "suspicious") | list | length %}
{% set n_low = report.indicators | selectattr("verdict.value", "equalto", "low_risk") | list | length %}
{% set n_other = total - n_mal - n_sus - n_low %}

<main class="wrap">
  <section class="hero">
    <h1>Investigation report</h1>
    <div class="meta">Generated {{ report.generated_at }} · OSINTCrawler v{{ report.tool_version }} · {{ total }} indicator{{ "s" if total != 1 }}</div>
    <div class="actions noprint">
      <button class="btn" type="button" id="dl-json-hero">Download JSON</button>
      {% if web %}<a class="btn" href="./">Start a new lookup</a>{% endif %}
    </div>
  </section>

  {% if report.ai_summary %}
  <section class="card ai">
    <h2 class="section-title">AI analyst summary</h2>
    <p class="muted" style="margin:0;">Generated by an LLM from the results below. Verify before acting.</p>
    <p>{{ report.ai_summary }}</p>
  </section>
  {% endif %}

  {% if report.warnings %}
  <section class="card" style="padding:14px;">
    {% for w in report.warnings %}<div class="warn">⚠ {{ w }}</div>{% endfor %}
  </section>
  {% endif %}

  <section class="stats" aria-label="Verdict counts">
    <div class="stat v-malicious"><div class="stat-num">{{ n_mal }}</div><div class="stat-label">Malicious</div></div>
    <div class="stat v-suspicious"><div class="stat-num">{{ n_sus }}</div><div class="stat-label">Suspicious</div></div>
    <div class="stat v-low_risk"><div class="stat-num">{{ n_low }}</div><div class="stat-label">Low risk</div></div>
    <div class="stat v-informational"><div class="stat-num">{{ n_other }}</div><div class="stat-label">Info / unknown</div></div>
  </section>

  <section class="card">
    <h2 class="section-title">Summary</h2>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Indicator</th><th>Type</th><th>Verdict</th><th>Risk</th><th>Key findings</th></tr></thead>
      <tbody>
      {% for rep in report.indicators %}
        <tr>
          <td class="ind-value"><a href="#ind-{{ loop.index }}">{{ rep.indicator.value }}</a></td>
          <td>{{ rep.indicator.type.value }}</td>
          <td><span class="badge v-{{ rep.verdict.value }}">{{ verdict_label(rep.indicator.type, rep.verdict) }}</span></td>
          <td>{% if rep.risk_score is not none %}
            <div class="risk v-{{ rep.verdict.value }}"><span class="risk-num">{{ rep.risk_score }}</span><div class="meter"><span style="width: {{ rep.risk_score }}%"></span></div></div>
          {% else %}<span class="muted">–</span>{% endif %}</td>
          <td class="findings">{% for s in rep.summary[:3] %}<div>{{ s }}</div>{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>

  {% for rep in report.indicators %}
  <section class="card ind-card" id="ind-{{ loop.index }}">
    <div class="ind-head">
      <span class="badge v-{{ rep.verdict.value }}">{{ verdict_label(rep.indicator.type, rep.verdict) }}</span>
      <h2 class="ind-value">{{ rep.indicator.value }}</h2>
      <span class="sub">{{ rep.indicator.type.value }}</span>
      {% if rep.risk_score is not none %}
      <div class="score v-{{ rep.verdict.value }}">
        <div class="meter"><span style="width: {{ rep.risk_score }}%"></span></div>
        <div class="sub" style="margin-top:4px;">Risk {{ rep.risk_score }}/100</div>
      </div>
      {% endif %}
    </div>
    {% if rep.indicator.original and rep.indicator.original != rep.indicator.value %}
      <div class="sub" style="margin-top:8px;">Input: <span class="ind-value">{{ rep.indicator.original }}</span></div>
    {% endif %}
    <ul class="summary-list">{% for s in rep.summary %}<li>{{ s }}</li>{% endfor %}</ul>
    {% if rep.tags %}<div>{% for t in rep.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>{% endif %}

    <h3 class="section-title" style="margin-top:20px;">Sources</h3>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Source</th><th>Status</th><th>Score</th><th>Findings</th></tr></thead>
      <tbody>
      {% for r in rep.results if r.status.value != "skipped" %}
        <tr>
          <td><div class="src-name">{{ r.source }}</div><div class="src-time">{{ r.elapsed_ms }} ms</div></td>
          <td><span class="status s-{{ r.status.value }}">{{ r.status.value | replace("_", " ") }}</span></td>
          <td style="font-weight:700;">{{ "–" if r.score is none else r.score }}</td>
          <td class="findings">
            {% for f in r.findings %}<div>{{ f }}</div>{% endfor %}
            {% if r.error %}<div class="s-error">{{ r.error }}</div>{% endif %}
            {% if r.tags %}<div>{% for t in r.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>{% endif %}
            {% if r.link and (r.link.startswith("https://") or r.link.startswith("http://")) %}
              <div><a href="{{ r.link }}" target="_blank" rel="noopener noreferrer nofollow">Open source ↗</a></div>
            {% endif %}
            {% if r.data %}
              <details><summary>Raw data</summary><pre>{{ r.data | pretty }}</pre></details>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% set skipped = rep.results | selectattr("status.value", "equalto", "skipped") | list %}
    {% if skipped %}
      <details><summary>{{ skipped|length }} source(s) skipped</summary>
        <ul>{% for r in skipped %}<li>{{ r.source }}: {{ r.error }}</li>{% endfor %}</ul>
      </details>
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    Generated by <a href="https://github.com/epikritis/OSINTCrawler" rel="noopener noreferrer">OSINTCrawler</a>.
    Scores are heuristic; corroborate before taking blocking or legal action.
  </footer>
</main>
<script type="application/json" id="report-data">{{ report_json | tojson }}</script>
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
(function () {
  var data = document.getElementById("report-data").textContent;
  function download() {
    var blob = new Blob([JSON.stringify(JSON.parse(data), null, 2)], {type: "application/json"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "osintcrawler-report.json";
    document.body.appendChild(a); a.click(); a.remove();
  }
  document.getElementById("dl-json").addEventListener("click", download);
  document.getElementById("dl-json-hero").addEventListener("click", download);
})();
</script>
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>{% include "_theme_toggle.js.j2" %}</script>
</body>
</html>
