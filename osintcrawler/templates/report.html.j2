<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>OSINTCrawler Report</title>
<style{% if nonce %} nonce="{{ nonce }}"{% endif %}>
:root {
  --bg: #f6f7f9; --panel: #ffffff; --text: #1b1f24; --muted: #5b6470; --border: #dfe3e8;
  --mal: #c62828; --sus: #b26a00; --low: #2e7d32; --info: #1565c0; --unk: #616161;
  --chip: #eef1f5; --code: #f3f5f8; --accent: #3949ab;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f1216; --panel: #171b21; --text: #e6e9ed; --muted: #9aa4b0; --border: #2a313a;
    --mal: #ef5350; --sus: #ffb74d; --low: #66bb6a; --info: #64b5f6; --unk: #9e9e9e;
    --chip: #222831; --code: #12161b; --accent: #8c9eff;
  }
}
:root[data-theme="dark"] {
  --bg: #0f1216; --panel: #171b21; --text: #e6e9ed; --muted: #9aa4b0; --border: #2a313a;
  --mal: #ef5350; --sus: #ffb74d; --low: #66bb6a; --info: #64b5f6; --unk: #9e9e9e;
  --chip: #222831; --code: #12161b; --accent: #8c9eff;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 1200px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 22px; margin: 0 0 4px; } h2 { font-size: 18px; margin: 0; } h3 { font-size: 15px; margin: 18px 0 8px; }
a { color: var(--accent); word-break: break-all; }
.muted { color: var(--muted); }
.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.btn { border: 1px solid var(--border); background: var(--panel); color: var(--text); padding: 6px 12px;
  border-radius: 6px; cursor: pointer; font: inherit; text-decoration: none; }
.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin: 16px 0; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; vertical-align: top; padding: 8px; border-bottom: 1px solid var(--border); }
th { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
.badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-weight: 700; font-size: 12px;
  color: #fff; white-space: nowrap; }
.v-malicious { background: var(--mal); } .v-suspicious { background: var(--sus); color: #1b1f24; }
.v-low_risk { background: var(--low); } .v-informational { background: var(--info); } .v-unknown { background: var(--unk); }
.risk { display: flex; align-items: center; gap: 6px; min-width: 90px; }
.risk-track { flex: 1; height: 6px; background: var(--chip); border-radius: 3px; overflow: hidden; }
.risk-fill { height: 100%; }
.chip { display: inline-block; background: var(--chip); border-radius: 4px; padding: 1px 6px; margin: 2px 4px 2px 0;
  font-size: 12px; }
.s-ok { color: var(--low); } .s-not_found { color: var(--info); } .s-error { color: var(--mal); } .s-skipped { color: var(--muted); }
ul.summary { margin: 8px 0; padding-left: 20px; }
details summary { cursor: pointer; color: var(--muted); }
pre { background: var(--code); border: 1px solid var(--border); border-radius: 6px; padding: 10px; overflow: auto;
  max-height: 420px; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
.ai { border-left: 4px solid var(--accent); white-space: pre-wrap; }
.warn { color: var(--sus); }
.ind-head { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.ind-value { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }
footer { margin-top: 32px; font-size: 12px; color: var(--muted); }
@media (max-width: 640px) { th:nth-child(2), td:nth-child(2) { display: none; } }
@media print { .noprint { display: none; } details { display: block; } }
</style>
</head>
<body>
<main>
  <div class="bar">
    <div>
      <h1>OSINTCrawler report</h1>
      <div class="muted">Generated {{ report.generated_at }} · v{{ report.tool_version }} · {{ report.indicators|length }} indicator(s)</div>
    </div>
    <div class="noprint">
      {% if web %}<a class="btn" href="./">New lookup</a>{% endif %}
      <button class="btn" type="button" id="dl-json">Download JSON</button>
      <button class="btn" type="button" id="theme">Toggle theme</button>
    </div>
  </div>

  {% if report.ai_summary %}
  <section class="panel ai">
    <h2>AI analyst summary</h2>
    <p class="muted">Generated by an LLM from the results below. Verify before acting.</p>
    <div>{{ report.ai_summary }}</div>
  </section>
  {% endif %}

  {% if report.warnings %}
  <section class="panel">
    {% for w in report.warnings %}<div class="warn">⚠ {{ w }}</div>{% endfor %}
  </section>
  {% endif %}

  <section class="panel">
    <h2>Summary</h2>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Indicator</th><th>Type</th><th>Verdict</th><th>Risk</th><th>Key findings</th></tr></thead>
      <tbody>
      {% for rep in report.indicators %}
        <tr>
          <td class="ind-value"><a href="#ind-{{ loop.index }}">{{ rep.indicator.value }}</a></td>
          <td>{{ rep.indicator.type.value }}</td>
          <td><span class="badge v-{{ rep.verdict.value }}">{{ verdict_label(rep.indicator.type, rep.verdict) }}</span></td>
          <td>{% if rep.risk_score is not none %}
            <div class="risk"><span>{{ rep.risk_score }}</span><div class="risk-track"><div class="risk-fill v-{{ rep.verdict.value }}" style="width: {{ rep.risk_score }}%"></div></div></div>
          {% else %}–{% endif %}</td>
          <td>{% for s in rep.summary[:3] %}<div>{{ s }}</div>{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </section>

  {% for rep in report.indicators %}
  <section class="panel" id="ind-{{ loop.index }}">
    <div class="ind-head">
      <span class="badge v-{{ rep.verdict.value }}">{{ verdict_label(rep.indicator.type, rep.verdict) }}</span>
      <h2 class="ind-value">{{ rep.indicator.value }}</h2>
      <span class="muted">{{ rep.indicator.type.value }}{% if rep.risk_score is not none %} · risk {{ rep.risk_score }}/100{% endif %}</span>
    </div>
    {% if rep.indicator.original and rep.indicator.original != rep.indicator.value %}
      <div class="muted">Input: <span class="ind-value">{{ rep.indicator.original }}</span></div>
    {% endif %}
    <ul class="summary">{% for s in rep.summary %}<li>{{ s }}</li>{% endfor %}</ul>
    {% if rep.tags %}<div>{% for t in rep.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>{% endif %}

    <h3>Sources</h3>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Source</th><th>Status</th><th>Score</th><th>Findings</th></tr></thead>
      <tbody>
      {% for r in rep.results if r.status.value != "skipped" %}
        <tr>
          <td><strong>{{ r.source }}</strong><div class="muted">{{ r.elapsed_ms }} ms</div></td>
          <td class="s-{{ r.status.value }}">{{ r.status.value }}</td>
          <td>{{ "–" if r.score is none else r.score }}</td>
          <td>
            {% for f in r.findings %}<div>{{ f }}</div>{% endfor %}
            {% if r.error %}<div class="s-error">{{ r.error }}</div>{% endif %}
            {% if r.tags %}<div>{% for t in r.tags %}<span class="chip">{{ t }}</span>{% endfor %}</div>{% endif %}
            {% if r.link and (r.link.startswith("https://") or r.link.startswith("http://")) %}
              <div><a href="{{ r.link }}" target="_blank" rel="noopener noreferrer nofollow">{{ r.link }}</a></div>
            {% endif %}
            {% if r.data %}
              <details><summary>Raw data</summary><pre>{{ r.data | pretty }}</pre></details>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% set skipped = rep.results | selectattr("status.value", "equalto", "skipped") | list %}
    {% if skipped %}
      <details><summary>{{ skipped|length }} source(s) skipped</summary>
        <ul>{% for r in skipped %}<li>{{ r.source }}: {{ r.error }}</li>{% endfor %}</ul>
      </details>
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    Generated by <a href="https://github.com/epikritis/OSINTCrawler" rel="noopener noreferrer">OSINTCrawler</a>.
    Scores are heuristic; corroborate before taking blocking or legal action.
  </footer>
</main>
<script type="application/json" id="report-data">{{ report_json | tojson }}</script>
<script{% if nonce %} nonce="{{ nonce }}"{% endif %}>
(function () {
  var data = document.getElementById("report-data").textContent;
  document.getElementById("dl-json").addEventListener("click", function () {
    var blob = new Blob([JSON.stringify(JSON.parse(data), null, 2)], {type: "application/json"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "osintcrawler-report.json";
    document.body.appendChild(a); a.click(); a.remove();
  });
  var root = document.documentElement;
  try { var saved = localStorage.getItem("oc-theme"); if (saved) root.setAttribute("data-theme", saved); } catch (e) {}
  document.getElementById("theme").addEventListener("click", function () {
    var dark = root.getAttribute("data-theme") ? root.getAttribute("data-theme") === "dark"
      : window.matchMedia("(prefers-color-scheme: dark)").matches;
    var next = dark ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("oc-theme", next); } catch (e) {}
  });
})();
</script>
</body>
</html>
