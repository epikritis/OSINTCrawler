<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>OSINTCrawler</title>
<style nonce="{{ nonce }}">
:root { --bg: #f6f7f9; --panel: #fff; --text: #1b1f24; --muted: #5b6470; --border: #dfe3e8; --accent: #3949ab; --err: #c62828; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --bg: #0f1216; --panel: #171b21; --text: #e6e9ed; --muted: #9aa4b0; --border: #2a313a; --accent: #8c9eff; --err: #ef5350; }
}
:root[data-theme="dark"] { --bg: #0f1216; --panel: #171b21; --text: #e6e9ed; --muted: #9aa4b0; --border: #2a313a; --accent: #8c9eff; --err: #ef5350; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 24px; margin: 0 0 4px; }
.muted { color: var(--muted); }
.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-top: 20px; }
label { display: block; font-weight: 600; margin: 12px 0 6px; }
textarea, input[type=password], select { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg); color: var(--text); font: 14px ui-monospace, SFMono-Regular, Menlo, monospace; }
textarea { min-height: 180px; resize: vertical; }
.row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-top: 16px; }
button { background: var(--accent); color: #fff; border: 0; border-radius: 6px; padding: 10px 18px; font: inherit; font-weight: 600; cursor: pointer; }
button.link { background: none; color: var(--muted); padding: 0; font-weight: 400; }
.err { color: var(--err); margin-top: 12px; }
code { background: var(--bg); padding: 1px 4px; border-radius: 4px; }
.check { display: flex; gap: 8px; align-items: center; font-weight: 400; margin: 0; }
</style>
</head>
<body>
<main>
  <h1>OSINTCrawler</h1>
  <div class="muted">Multi-source OSINT enrichment for IPs, domains, URLs, hashes, emails, phones, addresses, CVEs, ASNs, wallets and usernames.</div>

  {% if not configured %}
  <section class="panel">
    <strong>Server not configured.</strong>
    <p>Set an <code>ACCESS_TOKEN</code> environment variable (at least 16 characters) and redeploy.</p>
  </section>
  {% elif not authed %}
  <section class="panel">
    <form method="post" action="login" autocomplete="off">
      <label for="token">Access token</label>
      <input id="token" name="token" type="password" required autofocus>
      {% if error %}<div class="err">{{ error }}</div>{% endif %}
      <div class="row"><span class="muted">Sessions last 12 hours.</span><button type="submit">Sign in</button></div>
    </form>
  </section>
  {% else %}
  <section class="panel">
    <form method="post" action="lookup">
      <label for="indicators">Indicators (one per line, max {{ max_indicators }})</label>
      <textarea id="indicators" name="indicators" required placeholder="8.8.8.8&#10;hxxps://evil[.]example/login&#10;44d88612fea8a8f36de82e1278abb02f&#10;someone@example.com&#10;+254 712 345678&#10;CVE-2021-44228&#10;AS15169&#10;@username&#10;address: 1600 Pennsylvania Ave NW, Washington DC">{{ indicators or "" }}</textarea>
      <label for="type">Force type (optional)</label>
      <select id="type" name="type">
        <option value="">Auto-detect</option>
        {% for t in types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
      </select>
      {% if ai_available %}
      <label class="check"><input type="checkbox" name="ai_summary" value="1"> Add AI analyst summary (sends results to Anthropic)</label>
      {% endif %}
      {% if error %}<div class="err">{{ error }}</div>{% endif %}
      <div class="row"><span class="muted">Lookups disclose indicators to third-party services.</span><button type="submit">Investigate</button></div>
    </form>
    <form method="post" action="logout" class="row"><span></span><button class="link" type="submit">Sign out</button></form>
  </section>
  {% endif %}
</main>
</body>
</html>
